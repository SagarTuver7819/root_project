# ===========================================
# LIVE — roots.oceanhub.co.in
# Copy to `.env` on the server (do not commit)
# Document root MUST be: /public
# ===========================================

APP_NAME="Roots Dentistry"
APP_ENV=production
APP_DEBUG=false

# Live subdomain — document root = project folder (app, public, .env at same level)
# So site opens as: https://roots.oceanhub.co.in/public
APP_URL=https://roots.oceanhub.co.in/public
#
# Better (optional): cPanel → Domains → roots.oceanhub.co.in → Document Root
# change to .../roots.oceanhub.co.in/public  then use:
# APP_URL=https://roots.oceanhub.co.in
#
# NEVER set APP_URL without https:// (relative values cause redirect loops)
# NEVER use /roots_project/ on this live host (that path does not exist here)

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_KEY=change-this-to-a-long-random-secret-key
SESSION_NAME=roots_hms_session
UPLOAD_URL=

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_live_database
DB_USERNAME=your_live_db_user
DB_PASSWORD=your_live_db_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
