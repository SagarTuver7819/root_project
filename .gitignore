!/public/assets/uploads/branding/logo-main.jpg
!/public/assets/uploads/branding/logo-login.jpg
!/public/assets/uploads/branding/logo-sidebar.jpg
!/public/assets/uploads/branding/logo-collapsed.png
!/public/assets/uploads/branding/logo-dark.png

