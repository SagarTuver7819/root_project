# XAMPP: send project-root URLs to /public (correct front controller)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /roots_project/

    # Avoid loop
    RewriteRule ^public(/|$) - [L]

    # External redirect so browser URL becomes .../public/...
    RewriteRule ^(.*)$ public/$1 [R=302,L]
</IfModule>
