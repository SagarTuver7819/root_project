# Shared hosting: domain document root = project folder (not /public).
# Works for:
#   Live:  https://roots.oceanhub.co.in/        → /public/...
#   Local: http://localhost/roots_project/     → /roots_project/public/...
#
# Absolute Location (leading /) — relative "public/" causes URL loops.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Already under public/ — do not redirect again
    RewriteRule ^public(?:/|$) - [L]

    # Local XAMPP folder install
    RewriteCond %{REQUEST_URI} ^/roots_project/
    RewriteRule ^(.*)$ /roots_project/public/$1 [R=302,L]

    # Live subdomain (document root = this project folder)
    RewriteRule ^(.*)$ /public/$1 [R=302,L]
</IfModule>
