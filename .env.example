# ===========================================
# Roots HMS — Environment (DO NOT COMMIT)
# Copy this file to `.env` on each machine:
#   Local XAMPP  → copy as .env (defaults below work)
#   Live server  → copy as .env and set LIVE values
# ===========================================

APP_NAME="Roots Dentistry"
APP_ENV=local
APP_DEBUG=true

# Leave empty to auto-detect from request (recommended).
# Local:  APP_URL=http://localhost/roots_project/public
# Live:   APP_URL=https://roots.oceanhub.co.in
APP_URL=

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_KEY=roots-dental-hms-secret-key-change-me
SESSION_NAME=roots_hms_session

# Live DB update URL key (REQUIRED for browser migrate)
# Open: https://your-domain.com/migrate_live.php?key=RootsLiveUpdate2026
# After update: delete public/migrate_live.php OR clear this key
MIGRATE_KEY=RootsLiveUpdate2026

# Leave empty to auto-build from APP_URL
UPLOAD_URL=

# ---------- Database ----------
# Local XAMPP example:
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roots_dental_hms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Live example (replace with hosting DB details):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=your_live_db_name
# DB_USERNAME=your_live_db_user
# DB_PASSWORD=your_live_db_password
