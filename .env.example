# ===========================================
# Roots HMS — Environment (DO NOT COMMIT)
# Copy this file to `.env` on each machine:
#   Local XAMPP  → copy as .env (defaults below work)
#   Live server  → copy as .env and change values
# ===========================================

APP_NAME="Roots Dentistry"
APP_ENV=local
APP_DEBUG=true

# Leave APP_URL empty to auto-detect (recommended).
# Or set explicitly:
# Local:  APP_URL=http://localhost/roots_project/public
# Live:   APP_URL=https://hms.yourdomain.com
APP_URL=

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_KEY=roots-dental-hms-secret-key-change-me
SESSION_NAME=roots_hms_session

# Leave empty to auto-build from APP_URL
UPLOAD_URL=

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roots_dental_hms
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
